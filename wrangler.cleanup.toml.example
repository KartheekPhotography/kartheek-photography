name = "kartheek-quotation-jobs"
main = "cleanup-worker.js"
compatibility_date = "2026-11-25"

[triggers]
crons = ["*/1 * * * *", "17 0 * * *"]

[[d1_databases]]
binding = "DB"
database_name = "kartheek-quotes"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[[r2_buckets]]
binding = "QUOTE_PDFS"
bucket_name = "kartheek-quote-pdfs"
